                    <img src="${m.avatar}" alt="${m.name}" class="w-12 h-12 rounded-full object-cover border-2 border-teal-500">
                    <div class="overflow-hidden">
                        <div class="flex items-center space-x-2">
                            <h4 class="font-bold text-slate-800 group-hover:text-teal-600 transition truncate">${m.name}</h4>
                            <span class="text-[10px] bg-slate-200 text-slate-700 px-1.5 py-0.2 rounded">${m.group}組</span>
                        </div>
                        <p class="text-xs text-slate-500 truncate mt-0.5"><i class="fa-solid fa-heart-pulse text-teal-500 mr-1"></i>${m.interest}</p>
                    </div>
                </div>
            `).join('');
        }

        function openMemberModal(id) {
            const m = members.find(item => item.id === id);
            if (!m) return;

            const modalContent = document.getElementById('modal-content');
            modalContent.innerHTML = `
                <div class="text-center space-y-3">
                    <img src="${m.avatar}" alt="${m.name}" class="w-24 h-24 rounded-full mx-auto object-cover border-4 border-teal-500 shadow-md">
                    <div>
                        <span class="text-xs font-semibold px-2.5 py-1 bg-teal-100 text-teal-800 rounded-full">第 ${m.group} 組 · ${m.role}</span>
                        <h3 class="text-2xl font-bold text-slate-800 mt-2">${m.name}</h3>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-xl text-left text-xs space-y-2 border border-slate-100">
                        <p class="text-slate-600"><strong><i class="fa-solid fa-star text-amber-400 mr-1"></i>專長/興趣：</strong> ${m.interest}</p>
                        <p class="text-slate-600"><strong><i class="fa-solid fa-bullseye text-teal-600 mr-1"></i>未來展望/寄語：</strong> ${m.wish}</p>
                    </div>
                    <button onclick="closeMemberModal()" class="w-full bg-teal-600 text-white font-medium py-2 rounded-xl text-sm hover:bg-teal-700 transition">關閉</button>
                </div>
            `;
            document.getElementById('member-modal').classList.remove('hidden');
        }

        function closeMemberModal() {
            document.getElementById('member-modal').classList.add('hidden');
        }

        // --- CALENDAR LOGIC ---
        function renderCalendar() {
            const monthYearLabel = document.getElementById('calendar-month-year');
            const months = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];
            monthYearLabel.innerText = `${currentYear} 年 ${months[currentMonth]}`;

            const daysGrid = document.getElementById('calendar-days');
            daysGrid.innerHTML = '';

            const firstDay = new Date(currentYear, currentMonth, 1).getDay();
            const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

            // Blank padding for prior month
            for (let i = 0; i < firstDay; i++) {
                daysGrid.innerHTML += `<div class="p-2 text-slate-300"></div>`;
            }

            // Days rendering
            for (let d = 1; d <= daysInMonth; d++) {
                const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                const hasEvent = calendarEvents[dateStr] || getLocalNotes(dateStr).length > 0;

                daysGrid.innerHTML += `
                    <div onclick="selectDate('${dateStr}')" class="p-2 border rounded-xl hover:bg-teal-50 cursor-pointer transition flex flex-col items-center justify-between min-h-[48px] ${hasEvent ? 'border-teal-400 bg-teal-50/40 font-bold' : 'border-slate-100'}">
                        <span class="text-xs text-slate-700">${d}</span>
                        ${hasEvent ? '<span class="w-2 h-2 rounded-full bg-teal-600 mb-1"></span>' : ''}
                    </div>
                `;
            }
        }

        function changeMonth(delta) {
            currentMonth += delta;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            } else if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            }
            renderCalendar();
        }

        function resetCalendar() {
            currentYear = 2026;
            currentMonth = 9;
            renderCalendar();
        }

        function selectDate(dateStr) {
            const container = document.getElementById('selected-day-events');
            const events = calendarEvents[dateStr] || [];
            const localNotes = getLocalNotes(dateStr);

            if (events.length === 0 && localNotes.length === 0) {
                container.innerHTML = `<p class="text-slate-400 text-sm italic">${dateStr} 目前無預定事項。</p>`;
                return;
            }

            let html = `<div class="text-xs font-semibold text-teal-800 mb-2">${dateStr} 日程紀錄：</div>`;
            events.forEach(e => {
                html += `
                    <div class="p-2.5 rounded-lg bg-teal-50 border border-teal-100 text-xs">
                        <span class="font-bold text-teal-900">${e.title}</span>
                        <p class="text-slate-500 mt-0.5">${e.desc}</p>
                    </div>
                `;
            });
            localNotes.forEach(n => {
                html += `
                    <div class="p-2.5 rounded-lg bg-sky-50 border border-sky-100 text-xs">
                        <span class="font-bold text-sky-900">[私人/班級記事] ${n}</span>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function addCalendarNote(e) {
            e.preventDefault();
            const date = document.getElementById('note-date').value;
            const title = document.getElementById('note-title').value;

            if (!date || !title) return;

            const existing = getLocalNotes(date);
            existing.push(title);
            localStorage.setItem(`note_${date}`, JSON.stringify(existing));

            document.getElementById('note-title').value = '';
            renderCalendar();
            selectDate(date);
            alert('記事已成功儲存！');
        }

        function getLocalNotes(dateStr) {
            const stored = localStorage.getItem(`note_${dateStr}`);
            return stored ? JSON.parse(stored) : [];
        }

        // --- ACTIVITIES LOGIC ---
        function renderActivities(category = 'all') {
            const grid = document.getElementById('activities-grid');
            const filtered = category === 'all' ? activities : activities.filter(a => a.category === category);

            grid.innerHTML = filtered.map(a => `
                <div class="bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-md transition flex flex-col">
                    <img src="${a.img}" alt="${a.title}" class="w-full h-44 object-cover">
                    <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
                        <div>
                            <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                                <span><i class="fa-regular fa-calendar mr-1"></i>${a.date}</span>
                                <span><i class="fa-solid fa-location-dot mr-1"></i>${a.location}</span>
                            </div>
                            <h4 class="font-bold text-slate-800 text-base leading-snug">${a.title}</h4>
                            <p class="text-xs text-slate-500 mt-2 line-clamp-3 leading-relaxed">${a.desc}</p>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function filterActivities(cat) {
            document.querySelectorAll('.act-tab').forEach(btn => {
                btn.classList.remove('text-teal-700', 'bg-teal-100');
                btn.classList.add('text-slate-600');
            });
            const activeBtn = document.getElementById(`act-tab-${cat}`);
            if (activeBtn) {
                activeBtn.classList.add('text-teal-700', 'bg-teal-100');
                activeBtn.classList.remove('text-slate-600');
            }
            renderActivities(cat);
        }

        // --- MESSAGE BOARD & HUB TOOLS ---
        function postMessage(e) {
            e.preventDefault();
            const author = document.getElementById('msg-author').value;
            const tag = document.getElementById('msg-tag').value;
            const content = document.getElementById('msg-content').value;

            const newMsg = { author, tag, content, time: new Date().toLocaleDateString() };
            const msgs = getStoredMessages();
            msgs.unshift(newMsg);

            localStorage.setItem('class_messages', JSON.stringify(msgs));
            document.getElementById('msg-content').value = '';
            renderMessages();
        }

        function getStoredMessages() {
            const defaultMsgs = [
                { author: '班長 家豪', tag: '鼓勵', content: '護理一甲加油！大家考照訓練都要一次順利通過！', time: '2026-10-06' },
                { author: '導師 林靜怡', tag: '課業', content: '同學們期中報告有問題歡迎隨時前來辦公室討論喔～', time: '2026-10-04' }
            ];
            const stored = localStorage.getItem('class_messages');
            return stored ? JSON.parse(stored) : defaultMsgs;
        }

        function renderMessages() {
            const container = document.getElementById('messages-list');
            const msgs = getStoredMessages();

            container.innerHTML = msgs.map(m => `
                <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-100 space-y-1">
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-bold text-slate-800">${m.author}</span>
                        <span class="text-slate-400">${m.time}</span>
                    </div>
                    <span class="inline-block text-[10px] font-semibold px-2 py-0.5 rounded bg-teal-100 text-teal-800">${m.tag}</span>
                    <p class="text-xs text-slate-600 pt-1 leading-relaxed">${m.content}</p>
                </div>
            `).join('');
        }

        // Flashcards Logic
        function updateCard() {
            const card = flashcards[currentCardIndex];
            document.getElementById('card-category').innerText = card.cat;
            document.getElementById('card-term font-mono').innerText = card.term;
            document.getElementById('card-meaning').innerText = card.meaning;
            document.getElementById('card-meaning').classList.add('hidden');
            document.getElementById('card-counter').innerText = `${currentCardIndex + 1} / ${flashcards.length}`;
        }

        function flipCard() {
            document.getElementById('card-meaning').classList.toggle('hidden');
        }

        function nextCard() {
            currentCardIndex = (currentCardIndex + 1) % flashcards.length;
            updateCard();
        }

        function prevCard() {
            currentCardIndex = (currentCardIndex - 1 + flashcards.length) % flashcards.length;
            updateCard();
        }

        // Calculator Logic
        function calculateDrip() {
            const vol = parseFloat(document.getElementById('calc-volume').value);
            const hrs = parseFloat(document.getElementById('calc-hours').value);
            const factor = parseFloat(document.getElementById('calc-factor').value);

            if (!vol || !hrs || hrs <= 0) return;

            const totalMins = hrs * 60;
            const gttPerMin = Math.round((vol * factor) / totalMins);
            const secPerDrop = ((60 / gttPerMin)).toFixed(1);

            document.getElementById('result-gtt').innerText = `${gttPerMin} gtt/min`;
            document.getElementById('result-detail').innerText = `(約每 ${secPerDrop} 秒 1 滴)`;
            document.getElementById('calc-result').classList.remove('hidden');
        }

        function nextQuote() {
            currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
            document.getElementById('daily-quote').innerText = quotes[currentQuoteIndex];
        }

        // --- INITIALIZATION ---
        window.onload = function() {
            renderMembers();
            renderCalendar();
            renderActivities();
            renderMessages();
            updateCard();
        };
    </script>
</body>
</html>
